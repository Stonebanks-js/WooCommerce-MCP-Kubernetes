{
  "name": "@urumi/extra-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Two small upstream MCP servers (notes, utils) used to demo the Urumi MCP gateway",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "start:notes": "node dist/notes.js",
    "start:utils": "node dist/utils.js",
    "dev:notes": "node --watch src/notes.ts",
    "dev:utils": "node --watch src/utils.ts",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
