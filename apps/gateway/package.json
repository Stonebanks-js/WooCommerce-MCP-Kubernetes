{
  "name": "@urumi/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Urumi MCP Gateway: REST API, Streamable HTTP MCP endpoint and chat agent in front of upstream MCP servers",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "dev:pglite": "node scripts/dev-pglite.ts",
    "start": "node dist/index.js",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:tsx": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "cookie": "2.0.1",
    "express": "5.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
