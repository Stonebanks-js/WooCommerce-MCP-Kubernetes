{
  "name": "@urumi/woo-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WooCommerce MCP server: exposes a store's products and orders as MCP tools over Streamable HTTP",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
